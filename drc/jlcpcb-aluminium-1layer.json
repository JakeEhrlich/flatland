{
  "schema": "pcb-drc/1",
  "name": "jlcpcb-aluminium-1layer",
  "description": "JLCPCB single-layer aluminium (metal core) boards, HASL. Drill, slot and board-size limits from jlcpcb.com/capabilities/pcb-capabilities (read 2026-09-05); JLCPCB gives no separate trace/spacing figure for aluminium, so 0.15 mm is used as a conservative one. No plated holes or vias exist on this process.",
  "applies": {
    "layers": [
      1
    ],
    "material": "aluminium"
  },
  "rules": [
    {
      "name": "design-rules",
      "for": "board",
      "check": {
        "design_rules": {
          "trace_width": 0.15,
          "clearance": 0.15,
          "edge_clearance": 0.3
        }
      }
    },
    {
      "name": "design-rules-silk",
      "for": "board",
      "severity": "warning",
      "check": {
        "design_rules": {
          "silk_width": 0.15,
          "silk_text_size": 1.0
        }
      },
      "description": "Silkscreen stroke and text-height minimums are legibility guidance, not process limits."
    },
    {
      "name": "no-vias",
      "for": "via",
      "check": {
        "exists": false
      },
      "description": "A single-layer metal-core board has no plated holes at all."
    },
    {
      "name": "no-plated-holes",
      "for": "hole",
      "where": {
        "plated": true
      },
      "check": {
        "exists": false
      }
    },
    {
      "name": "trace-width",
      "for": "copper",
      "check": {
        "min_width": 0.15
      }
    },
    {
      "name": "copper-spacing",
      "for": "copper",
      "check": {
        "clearance": {
          "to": "copper",
          "relation": "different_net",
          "min": 0.15
        }
      }
    },
    {
      "name": "copper-gap",
      "for": "copper",
      "severity": "warning",
      "check": {
        "min_gap": 0.25
      },
      "description": "Same-net copper closer than 0.25 mm without touching (a pad beside its own via, a trace grazing its pad) is an etch sliver or an acid trap; JLCPCB's same-net spacing figure."
    },
    {
      "name": "hole-size",
      "for": "hole",
      "check": {
        "min": {
          "drill": 0.65
        }
      },
      "description": "Minimum drill 0.65 mm in aluminium."
    },
    {
      "name": "hole-to-hole",
      "for": "hole",
      "check": {
        "clearance": {
          "to": "hole",
          "relation": "any",
          "min": 0.45
        }
      }
    },
    {
      "name": "hole-to-copper",
      "for": "hole",
      "check": {
        "clearance": {
          "to": "copper",
          "relation": "any",
          "min": 0.3
        }
      }
    },
    {
      "name": "copper-to-edge",
      "for": "copper",
      "check": {
        "clearance": {
          "to": "outline",
          "min": 0.3
        }
      }
    },
    {
      "name": "mask-dam",
      "for": "mask_opening",
      "severity": "warning",
      "check": {
        "min_gap": 0.1
      }
    },
    {
      "name": "silk-width",
      "for": "silk",
      "check": {
        "min_width": 0.15
      }
    },
    {
      "name": "silk-text-width",
      "for": "silk_text",
      "check": {
        "min_width": 0.15
      }
    },
    {
      "name": "silk-text-height",
      "for": "silk_text",
      "severity": "info",
      "check": {
        "min": {
          "height": 1.0
        }
      },
      "description": "Text under 1 mm prints but may not be legible."
    },
    {
      "name": "board-min-size",
      "for": "board",
      "check": {
        "min": {
          "width": 5,
          "height": 5
        }
      }
    },
    {
      "name": "board-max-size",
      "for": "board",
      "check": {
        "max": {
          "width": 602,
          "height": 506
        }
      }
    },
    {
      "name": "mask-bridge",
      "for": "mask_opening",
      "check": {
        "min_gap": 0.05
      },
      "description": "Mask between openings thinner than 0.05 mm will not survive at all: two bare features sit exposed side by side under the finish."
    },
    {
      "name": "via-near-pad",
      "for": "via",
      "severity": "warning",
      "check": {
        "clearance": {
          "to": "pad",
          "relation": "any",
          "min": 0.2
        }
      },
      "description": "An untented via inside or within 0.2 mm of a pad merges its mask opening with the pad's and wicks paste down the hole; escape by the pad's half extent plus the via radius plus 0.2 mm, or tent the vias (`rules set tent_vias=1`)."
    }
  ]
}
