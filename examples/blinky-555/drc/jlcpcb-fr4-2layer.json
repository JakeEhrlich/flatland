{
  "schema": "pcb-drc/1",
  "name": "jlcpcb-fr4-2layer",
  "description": "JLCPCB 1-2 layer FR4, 1 oz copper, standard process. Values from jlcpcb.com/capabilities/pcb-capabilities, read 2026-09-05; re-check before relying on them.",
  "applies": {
    "layers": [
      1,
      2
    ],
    "material": "fr4"
  },
  "rules": [
    {
      "name": "design-rules",
      "for": "board",
      "check": {
        "design_rules": {
          "trace_width": 0.1,
          "clearance": 0.1,
          "via_drill": 0.15,
          "via_diameter": 0.25,
          "edge_clearance": 0.2
        }
      },
      "description": "The project's own rules must not be looser than the process allows."
    },
    {
      "name": "design-rules-silk",
      "for": "board",
      "severity": "warning",
      "check": {
        "design_rules": {
          "silk_width": 0.15,
          "silk_text_size": 1.0
        }
      },
      "description": "Silkscreen stroke and text-height minimums are legibility guidance, not process limits."
    },
    {
      "name": "trace-width",
      "for": "copper",
      "check": {
        "min_width": 0.1
      },
      "description": "Min trace width 0.10 mm (4 mil) at 1 oz; pours are checked for slivers the same way."
    },
    {
      "name": "copper-spacing",
      "for": "copper",
      "check": {
        "clearance": {
          "to": "copper",
          "relation": "different_net",
          "min": 0.1
        }
      },
      "description": "Min spacing 0.10 mm (4 mil) at 1 oz."
    },
    {
      "name": "copper-gap",
      "for": "copper",
      "severity": "warning",
      "check": {
        "min_gap": 0.1
      },
      "description": "Gaps inside same-net copper narrower than the spacing limit (acid traps)."
    },
    {
      "name": "via-drill",
      "for": "via",
      "check": {
        "min": {
          "drill": 0.15
        }
      }
    },
    {
      "name": "via-diameter",
      "for": "via",
      "check": {
        "min": {
          "diameter": 0.25
        }
      }
    },
    {
      "name": "pth-annular-ring",
      "for": "pad",
      "where": {
        "kind": "through_hole",
        "plated": true
      },
      "check": {
        "min": {
          "annular_ring": 0.18
        }
      },
      "description": "Absolute minimum plated-hole annular ring 0.18 mm; 0.25 mm recommended."
    },
    {
      "name": "pth-annular-ring-recommended",
      "for": "pad",
      "where": {
        "kind": "through_hole",
        "plated": true
      },
      "severity": "warning",
      "check": {
        "min": {
          "annular_ring": 0.25
        }
      }
    },
    {
      "name": "npth-size",
      "for": "hole",
      "where": {
        "plated": false
      },
      "check": {
        "min": {
          "drill": 0.5
        }
      },
      "description": "Minimum non-plated hole 0.5 mm."
    },
    {
      "name": "hole-to-hole",
      "for": "hole",
      "check": {
        "clearance": {
          "to": "hole",
          "relation": "any",
          "min": 0.45
        }
      }
    },
    {
      "name": "hole-to-copper",
      "for": "hole",
      "check": {
        "clearance": {
          "to": "copper",
          "relation": "different_net",
          "min": 0.28
        }
      },
      "description": "Hole to other-net copper 0.28 mm (unplated holes count as no net)."
    },
    {
      "name": "copper-to-edge",
      "for": "copper",
      "check": {
        "clearance": {
          "to": "outline",
          "min": 0.2
        }
      },
      "description": "Copper to routed board edge 0.2 mm."
    },
    {
      "name": "mask-dam",
      "for": "mask_opening",
      "severity": "warning",
      "check": {
        "min_gap": 0.1
      },
      "description": "Solder mask between openings narrower than 0.10 mm will not survive; the fab merges the openings."
    },
    {
      "name": "silk-width",
      "for": "silk",
      "check": {
        "min_width": 0.15
      }
    },
    {
      "name": "silk-text-width",
      "for": "silk_text",
      "check": {
        "min_width": 0.15
      }
    },
    {
      "name": "silk-text-height",
      "for": "silk_text",
      "severity": "info",
      "check": {
        "min": {
          "height": 1.0
        }
      },
      "description": "Text under 1 mm prints but may not be legible."
    },
    {
      "name": "board-size",
      "for": "board",
      "check": {
        "max": {
          "width": 670,
          "height": 600
        }
      }
    }
  ]
}
